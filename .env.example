# Copy this file to .env.local and fill in your Supabase project values.
# Without them the app runs in browser-only mode (no server, sample data).
# See SUPABASE.md for the full setup guide.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The browser-safe key: "Publishable key" (sb_publishable_...) in new projects,
# or "anon public" in older ones. Never the secret / service_role key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
